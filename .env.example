# Local development defaults only. Never add credentials here.
APP_ENV=development
DATABASE_URL=sqlite:///inventraiq-dev.db
# Set a persistent random value privately; blank uses a development-only fallback.
SECRET_KEY=
SESSION_COOKIE_SECURE=false
HTTPS_REQUIRED=false
FLASK_DEBUG=0
AUTH_THROTTLE_BACKEND=database
AUTH_ACCOUNT_LIMIT=10
AUTH_IP_LIMIT=50
AUTH_THROTTLE_WINDOW_SECONDS=900
AUTH_THROTTLE_SLOTS=16384
AUTH_IDLE_SECONDS=1800
AUTH_ABSOLUTE_SECONDS=28800
# T27 stays off until the additive migration and capability policy are approved.
ASSISTANT_PROPOSALS_ENABLED=false
# Production: APP_ENV=production, stable SECRET_KEY (>=32 characters),
# SESSION_COOKIE_SECURE=true, HTTPS_REQUIRED=true, FLASK_DEBUG=false,
# MySQL/PyMySQL and DB_SSL_CA pointing to a trusted CA file are required.
# Without DATABASE_URL, provide all DB_USER/DB_PASSWORD/DB_HOST/DB_NAME;
# DB_PORT defaults to 3306. Do not put real values in this example file.
